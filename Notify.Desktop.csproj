<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>Notify.Desktop.Program</StartupObject>
    <AssemblyName>ALXPRGS.Notify.Desktop</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;tests/**</DefaultItemExcludes>
    <!-- WPF owns process DPI awareness through the manifest. WinForms supplies only the tray. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Notify.ico</ApplicationIcon>
    <RootNamespace>Notify.Desktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Notify.ico" />
    <InternalsVisibleTo Include="Notify.Desktop.Specs" />
  </ItemGroup>
</Project>
