<Window x:Class="Notify.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ALXPRGS Notify Desktop" Width="1010" Height="720" MinWidth="620" MinHeight="470"
        Icon="Assets/Notify.ico" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Outline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="32"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Description" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Outline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonTile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonTile" Property="Opacity" Value=".85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonTile" Property="Opacity" Value=".7"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonTile" Property="BorderBrush" Value="{DynamicResource AccentFill}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonTile" Property="Opacity" Value=".52"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
      <Setter Property="Padding" Value="14,7"/>
    </Style>
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,5,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tile" Padding="12,8" CornerRadius="6" BorderThickness="1"
                    BorderBrush="Transparent" Background="Transparent">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Surface}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectedSurface}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFill}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ChatLabel">
      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>
  </Window.Resources>
  <Grid Background="{DynamicResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1" Background="{DynamicResource Chrome}">
      <StackPanel Margin="26,16,26,6">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <Image Source="Assets/Notify.ico" Width="27" Height="27" Margin="0,0,10,0"/>
          <TextBlock Text="ALXPRGS Notify" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
        </StackPanel>
        <WrapPanel>
          <RadioButton Style="{StaticResource NavItem}" GroupName="Pages" Tag="0" IsChecked="True" Checked="Navigate"
                       AutomationProperties.Name="Главная">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Margin="0,0,8,0"/><TextBlock Text="Главная"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="ConnectionsNav" Style="{StaticResource NavItem}" GroupName="Pages" Tag="1" Checked="Navigate"
                       AutomationProperties.Name="Подключения">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71B;" Margin="0,0,8,0"/><TextBlock Text="Подключения"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="CallsNav" Style="{StaticResource NavItem}" GroupName="Pages" Tag="4" Checked="Navigate" AutomationProperties.Name="Звонки">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE717;" Margin="0,0,8,0"/><TextBlock Text="Звонки"/></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" GroupName="Pages" Tag="2" Checked="Navigate"
                       AutomationProperties.Name="Диагностика">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Margin="0,0,8,0"/><TextBlock Text="Диагностика"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="SettingsNav" Style="{StaticResource NavItem}" GroupName="Pages" Tag="3" Checked="Navigate"
                       AutomationProperties.Name="Настройки">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,8,0"/><TextBlock Text="Настройки"/></StackPanel>
          </RadioButton>
        </WrapPanel>
      </StackPanel>
    </Border>
    <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="28,22,28,24" MaxWidth="1060">
        <StackPanel x:Name="HomePage">
          <TextBlock Text="Главная" Style="{StaticResource PageTitle}"/>
          <Border Style="{StaticResource Card}" Margin="0,12,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Клиент" Style="{StaticResource Description}"/>
                <TextBlock x:Name="HomeClient" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="HomeClientState" Style="{StaticResource Description}"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Основная сессия" Style="{StaticResource Description}"/>
                <TextBlock x:Name="HomePrimaryChat" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="HomePrimaryState" Style="{StaticResource Description}"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Телефонный помощник" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="PhoneHomeState" Style="{StaticResource Description}" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock Text="Разговоры с Asterisk продолжаются в отдельном телефонном чате Codex." Style="{StaticResource Description}" Margin="0,4,0,8"/>
              <TextBlock x:Name="PhoneHomeContext" Text="Заполнение контекста · Нет данных" Style="{StaticResource Description}"/>
              <TextBlock x:Name="PhoneHomeUsage" Text="Суммарное потребление · Нет данных" Style="{StaticResource Description}"/>
              <TextBlock x:Name="PhoneLastCall" Text="Последний разговор · Нет данных" Style="{StaticResource Description}"/>
              <ProgressBar x:Name="PhoneContextMeter" Maximum="100" Height="5" Margin="0,8,0,0" Visibility="Collapsed"
                           AutomationProperties.Name="Заполнение контекста телефонного чата"/>
            </StackPanel>
          </Border>
          <WrapPanel Margin="0,6,0,0">
            <Button Content="Настроить подключение" Click="OpenConnections" Style="{StaticResource AccentButton}" Margin="0,0,8,8"/>
            <Button x:Name="Stop" Content="Отключить" IsEnabled="False" Click="Disconnect" Margin="0,0,8,8"/>
            <Button Content="Свернуть в трей" Click="HideWindow" Margin="0,0,0,8"/>
          </WrapPanel>
        </StackPanel>
        <StackPanel x:Name="ConnectionsPage" Visibility="Collapsed">
          <TextBlock Text="Подключения" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Укажите источник Notify и выберите клиент разговора." Style="{StaticResource Description}" Margin="0,0,0,20"/>
          <StackPanel x:Name="Setup">
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
          <TextBlock Text="Сервер и доступ" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="HTTPS-адрес Notify" Margin="0,0,0,5"/>
          <TextBox x:Name="Origin" Margin="0,0,0,11" AutomationProperties.Name="HTTPS-адрес Notify"/>
          <TextBlock x:Name="TokenLabel" Text="Токен источника" Margin="0,0,0,5"/>
          <PasswordBox x:Name="Token" Margin="0,0,0,11" AutomationProperties.Name="Токен источника"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
          <TextBlock Text="Клиент и чат" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Клиент" Margin="0,0,0,5"/>
          <ComboBox x:Name="Client" SelectedIndex="0" SelectionChanged="ClientChanged"
                    AutomationProperties.Name="Клиент" Padding="8,5" Margin="0,0,0,11">
            <ComboBoxItem Content="Codex"/>
            <ComboBoxItem Content="Harness"/>
          </ComboBox>
          <StackPanel x:Name="CodexPicker">
            <TextBlock Text="Существующий чат Codex" Margin="0,0,0,5"/>
            <DockPanel Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Content="Обновить список" Click="RefreshChats" Margin="8,0,0,0"/>
              <ComboBox x:Name="Chats" Padding="8,5" MaxDropDownHeight="320" ItemTemplate="{StaticResource ChatLabel}"
                        AutomationProperties.Name="Существующий чат Codex"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Content="Найти доступный чат" Click="FindAvailableChat" Margin="8,0,0,0"/>
              <TextBlock x:Name="ChatStatus" Text="Выберите чат из списка." VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
          </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
          <WrapPanel>
            <Button Content="Подключить" Click="Connect" Style="{StaticResource AccentButton}" FontWeight="SemiBold"/>
            <Button Content="Проверить соединение" Click="Check"/>
            <Button Content="Кабинет Notify" Click="OpenCabinet"/>
          </WrapPanel>
          </Border>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed">
          <TextBlock Text="Диагностика" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Регистрация агента и последние события подключения." Style="{StaticResource Description}" Margin="0,0,0,20"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Регистрация" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <TextBlock Text="Agent ID"/>
              <DockPanel Margin="0,4,0,10">
                <Button DockPanel.Dock="Right" Content="Копировать" Click="CopyId" Tag="Agent" AutomationProperties.Name="Копировать Agent ID" Margin="8,0,0,0"/>
                <TextBox x:Name="AgentId" IsReadOnly="True" AutomationProperties.Name="Agent ID"/>
              </DockPanel>
              <TextBlock Text="Source ID"/>
              <DockPanel Margin="0,4,0,12">
                <Button DockPanel.Dock="Right" Content="Копировать" Click="CopyId" Tag="Source" AutomationProperties.Name="Копировать Source ID" Margin="8,0,0,0"/>
                <TextBox x:Name="SourceId" IsReadOnly="True" AutomationProperties.Name="Source ID"/>
              </DockPanel>
              <Button Content="Проверить соединение" Click="Check" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Состояние подсистем" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal"><TextBlock Text="Сервер Notify · "/><TextBlock x:Name="NotifyState" Text="Не проверен" Style="{StaticResource Description}"/></StackPanel>
              <StackPanel Orientation="Horizontal"><TextBlock Text="Соединение агента · "/><TextBlock x:Name="SocketState" Text="Отключён" Style="{StaticResource Description}"/></StackPanel>
              <StackPanel Orientation="Horizontal"><TextBlock Text="Codex · "/><TextBlock x:Name="CodexState" Style="{StaticResource Description}"/></StackPanel>
              <TextBlock x:Name="CurrentCodexChat" Style="{StaticResource Description}"/>
              <StackPanel Orientation="Horizontal"><TextBlock Text="Harness · "/><TextBlock x:Name="HarnessState" Style="{StaticResource Description}"/></StackPanel>
              <TextBlock Style="{StaticResource Description}" Text="{Binding Text, ElementName=PhoneHomeState, StringFormat='Телефонный помощник: {0}'}"/>
              <TextBlock x:Name="NotifyLatency" Style="{StaticResource Description}" Text="Время проверки Notify: нет данных"/>
              <TextBlock Text="Последние события" FontSize="19" FontWeight="SemiBold" Margin="0,14,0,8"/>
              <TextBlock x:Name="History" Text="Событий пока нет." Style="{StaticResource Description}" LineHeight="23"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="CallsPage" Visibility="Collapsed">
          <TextBlock Text="Звонки" Style="{StaticResource PageTitle}"/>
          <WrapPanel Margin="0,8,0,8">
            <StackPanel Margin="0,0,6,4"><TextBlock Text="Поиск" Style="{StaticResource Description}"/>
              <TextBox x:Name="CallSearch" Width="145" TextChanged="FilterCalls" AutomationProperties.Name="Поиск по звонкам" ToolTip="Дата, ID или источник"/>
            </StackPanel>
            <StackPanel Margin="0,0,6,4"><TextBlock Text="Дата" Style="{StaticResource Description}"/>
              <DatePicker x:Name="CallDay" SelectedDateChanged="FilterCalls" AutomationProperties.Name="Дата звонка"/>
            </StackPanel>
            <ComboBox x:Name="CallStatusFilter" SelectedIndex="0" SelectionChanged="FilterCalls" AutomationProperties.Name="Статус звонка" VerticalAlignment="Bottom" Margin="0,0,6,4">
              <ComboBoxItem Content="Все статусы" Tag=""/>
              <ComboBoxItem Content="Текущие" Tag="active"/>
              <ComboBoxItem Content="Завершённые" Tag="ended"/>
              <ComboBoxItem Content="Не состоялись" Tag="failed"/>
            </ComboBox>
            <Button Content="Обновить" Click="RefreshCalls" VerticalAlignment="Bottom" Margin="0,0,6,4"/>
          </WrapPanel>
          <TextBlock x:Name="CallsStatus" Style="{StaticResource Description}" AutomationProperties.LiveSetting="Polite"/>
          <ListBox x:Name="CallsList" SelectionChanged="SelectCall" DisplayMemberPath="Summary" MinHeight="72" MaxHeight="178" Margin="0,6,0,12" AutomationProperties.Name="История звонков"/>
          <TabControl x:Name="CallDetail" Visibility="Collapsed">
            <TabItem Header="Обзор"><StackPanel Margin="10"><TextBlock x:Name="CallSummary" Style="{StaticResource Description}"/><TextBlock x:Name="CallIdentity" Style="{StaticResource Description}" Margin="0,8,0,0"/><TextBlock Text="Средние длительности этапов" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock x:Name="CallKeyTimings" Style="{StaticResource Description}"/></StackPanel></TabItem>
            <TabItem Header="Таймлайн"><StackPanel Margin="10"><TextBlock x:Name="CallTraceStatus" Style="{StaticResource Description}"/><Canvas x:Name="CallTimeline" Height="80" Background="{DynamicResource AppBackground}" SizeChanged="DrawCallTimeline" Margin="0,8,0,0"/></StackPanel></TabItem>
            <TabItem Header="Реплики"><StackPanel Margin="10"><TextBlock x:Name="CallTranscriptStatus" Style="{StaticResource Description}"/><ItemsControl x:Name="CallTurns" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></TabItem>
            <TabItem x:Name="CallDetailsTab" Header="Подробности"><StackPanel Margin="10"><ListBox x:Name="CallEvents" SelectionChanged="ShowCallEvent" DisplayMemberPath="Label" MaxHeight="220" AutomationProperties.Name="Этапы звонка"/><TextBlock x:Name="CallEventDetails" Style="{StaticResource Description}" Margin="0,8,0,0"/></StackPanel></TabItem>
            <TabItem Header="Диагностика"><Button x:Name="CopyCallReport" Content="Копировать диагностику" Click="CopyCallDiagnostics" IsEnabled="False" HorizontalAlignment="Left" Margin="10"/></TabItem>
          </TabControl>
        </StackPanel>
        <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
          <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
          <Border Style="{StaticResource Card}" Margin="0,16,0,12">
            <StackPanel>
              <TextBlock Text="Оформление" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <ComboBox x:Name="Appearance" HorizontalAlignment="Left" MinWidth="175"
                        AutomationProperties.Name="Тема оформления" SelectionChanged="ChangeAppearance">
                <ComboBoxItem Content="Как в Windows" Tag="System"/>
                <ComboBoxItem Content="Светлая" Tag="Light"/>
                <ComboBoxItem Content="Тёмная" Tag="Dark"/>
              </ComboBox>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Фоновая работа" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <CheckBox x:Name="AutoStart" Content="Запускать в трее при входе в Windows" Margin="0,0,0,9" Click="ChangeStartup"/>
              <CheckBox x:Name="KeepInTray" Content="Оставлять приложение в трее при закрытии окна" Click="ChangeBackground"/>
              <TextBlock Text="В трее агент остаётся на связи. Для полного завершения используйте «Выход»." Style="{StaticResource Description}" Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Телефонный помощник" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <TextBlock x:Name="PhoneAssistantStatus" Style="{StaticResource Description}" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock x:Name="PhoneAssistantCall" Style="{StaticResource Description}" Margin="0,4,0,0"/>
              <CheckBox x:Name="PhoneAssistantEnabled" Content="Включить телефонного помощника" Click="ChangePhoneMode" Margin="0,8,0,0"/>
              <Button Content="Создать новый телефонный чат" Click="NewPhoneThread" Margin="0,8,0,0"/>
              <Button Content="Сжать контекст текущего чата" Click="CompactPhoneThread" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Контекст и инструкции Codex" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="Создавать новый телефонный чат после звонка при заполнении контекста на, %" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <TextBlock Text="При достижении порога Notify переносит контекст после завершения звонка. Диапазон 70–100 %. По умолчанию 85 %. Для переноса нужны данные о заполнении." Style="{StaticResource Description}"/>
              <TextBox x:Name="RolloverPercent" AutomationProperties.Name="Порог переноса в процентах"/>
              <TextBlock x:Name="PhoneRolloverStatus" Text="Перенос контекста не запущен." Style="{StaticResource Description}" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock Text="Общие инструкции для всех разговоров" TextWrapping="Wrap"/>
              <TextBlock Text="Правила для телефонного помощника и обращений через выбранный чат Codex." Style="{StaticResource Description}"/>
              <TextBox x:Name="GeneralInstructions" AutomationProperties.Name="Общие инструкции" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" MinHeight="56"/>
              <TextBlock Text="Инструкции телефонного помощника" TextWrapping="Wrap"/>
              <TextBlock Text="Манера речи, длина ответа и поведение в отдельной телефонной сессии." Style="{StaticResource Description}"/>
              <TextBox x:Name="PhoneInstructions" AutomationProperties.Name="Инструкции телефонного помощника" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" MinHeight="56"/>
              <TextBlock Text="Инструкции для выбранного чата Codex" TextWrapping="Wrap"/>
              <TextBlock Text="Добавляются к реплике и сохраняются в истории выбранного чата." Style="{StaticResource Description}"/>
              <TextBox x:Name="ChatInstructions" AutomationProperties.Name="Инструкции обычного чата" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" MinHeight="56"/>
              <WrapPanel Margin="0,8,0,0">
                <Button Content="Сохранить" Click="SaveInstructions"/>
                <Button Content="Предпросмотр" Click="PreviewInstructions"/>
                <Button Content="Сбросить" Click="ResetInstructions"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Обновления" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <TextBlock x:Name="InstalledUpdateVersion" Style="{StaticResource Description}"/>
              <TextBlock x:Name="LatestUpdateVersion" Text="Последняя стабильная версия · Нет данных" Style="{StaticResource Description}"/>
              <TextBlock x:Name="UpdateCheckedAt" Text="Последняя проверка · Нет данных" Style="{StaticResource Description}"/>
              <TextBlock x:Name="UpdateStatus" Style="{StaticResource Description}" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock x:Name="UpdateIntegrity" Text="Установщик не загружен." Style="{StaticResource Description}"/>
              <WrapPanel Margin="0,8,0,0">
                <Button x:Name="CheckForUpdates" Content="Проверить обновления" Click="CheckUpdates"/>
                <Button x:Name="CancelDownload" Content="Отменить загрузку" Click="CancelUpdate" IsEnabled="False"/>
              </WrapPanel>
              <StackPanel x:Name="UpdateOffer" Visibility="Collapsed" Margin="0,8,0,0">
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="UpdateNotes" Style="{StaticResource Description}"/>
                </ScrollViewer>
                <WrapPanel Margin="0,8,0,0">
                  <Button x:Name="DownloadInstaller" Content="Скачать обновление" Click="DownloadUpdate" Style="{StaticResource AccentButton}"/>
                  <Button x:Name="InstallInstaller" Content="Установить" Click="InstallUpdate" Style="{StaticResource AccentButton}" IsEnabled="False"/>
                  <Button x:Name="DeferUpdate" Content="Позже" Click="DismissUpdate"/>
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Padding="28,10">
      <TextBlock x:Name="Status" Text="Отключено" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"
                 AutomationProperties.LiveSetting="Polite"/>
    </Border>
  </Grid>
</Window>
