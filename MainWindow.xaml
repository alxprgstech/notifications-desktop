<Window x:Class="Notify.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ALXPRGS Notify Desktop" Width="1010" Height="720" MinWidth="620" MinHeight="470"
        Icon="Assets/Notify.ico" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Outline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="32"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Description" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
      <Setter Property="Padding" Value="14,7"/>
    </Style>
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,5,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tile" Padding="12,8" CornerRadius="6" BorderThickness="1"
                    BorderBrush="Transparent" Background="Transparent">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Surface}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectedSurface}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFill}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ChatLabel">
      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1" Background="{DynamicResource Chrome}">
      <StackPanel Margin="26,16,26,6">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <Image Source="Assets/Notify.ico" Width="27" Height="27" Margin="0,0,10,0"/>
          <TextBlock Text="ALXPRGS Notify" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
        </StackPanel>
        <WrapPanel>
          <RadioButton Style="{StaticResource NavItem}" GroupName="Pages" Tag="0" IsChecked="True" Checked="Navigate"
                       AutomationProperties.Name="Главная">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Margin="0,0,8,0"/><TextBlock Text="Главная"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="ConnectionsNav" Style="{StaticResource NavItem}" GroupName="Pages" Tag="1" Checked="Navigate"
                       AutomationProperties.Name="Подключения">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71B;" Margin="0,0,8,0"/><TextBlock Text="Подключения"/></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" GroupName="Pages" Tag="2" Checked="Navigate"
                       AutomationProperties.Name="Диагностика">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Margin="0,0,8,0"/><TextBlock Text="Диагностика"/></StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource NavItem}" GroupName="Pages" Tag="3" Checked="Navigate"
                       AutomationProperties.Name="Настройки">
            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,8,0"/><TextBlock Text="Настройки"/></StackPanel>
          </RadioButton>
        </WrapPanel>
      </StackPanel>
    </Border>
    <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="28,22,28,24" MaxWidth="1060">
        <StackPanel x:Name="HomePage">
          <TextBlock Text="Главная" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Состояние сервера, клиентов и агентского соединения." Style="{StaticResource Description}" Margin="0,0,0,20"/>
          <UniformGrid Columns="2">
            <Border Style="{StaticResource Card}" Margin="0,0,6,12">
              <StackPanel>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE753;" Foreground="{DynamicResource AccentDetail}"/>
                <TextBlock Text="Notify" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,3"/>
                <TextBlock x:Name="NotifyState" Text="Не проверен" Style="{StaticResource Description}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,12">
              <StackPanel>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE774;" Foreground="{DynamicResource AccentDetail}"/>
                <TextBlock Text="WebSocket агента" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,9,0,3"/>
                <TextBlock x:Name="SocketState" Text="Отключён" Style="{StaticResource Description}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,6,12">
              <StackPanel>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE756;" Foreground="{DynamicResource AccentDetail}"/>
                <TextBlock Text="Codex" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,3"/>
                <TextBlock x:Name="CodexState" Style="{StaticResource Description}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,12">
              <StackPanel>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F4;" Foreground="{DynamicResource AccentDetail}"/>
                <TextBlock Text="Harness" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,3"/>
                <TextBlock x:Name="HarnessState" Style="{StaticResource Description}"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <WrapPanel Margin="0,6,0,0">
            <Button Content="Настроить подключение" Click="OpenConnections" Style="{StaticResource AccentButton}" Margin="0,0,8,8"/>
            <Button x:Name="Stop" Content="Отключить" IsEnabled="False" Click="Disconnect" Margin="0,0,8,8"/>
            <Button Content="Свернуть в трей" Click="HideWindow" Margin="0,0,0,8"/>
          </WrapPanel>
        </StackPanel>
        <StackPanel x:Name="ConnectionsPage" Visibility="Collapsed">
          <TextBlock Text="Подключения" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Укажите источник Notify и выберите клиент разговора." Style="{StaticResource Description}" Margin="0,0,0,20"/>
          <Border Style="{StaticResource Card}">
        <StackPanel x:Name="Setup">
          <TextBlock Text="HTTPS-адрес Notify" Margin="0,0,0,5"/>
          <TextBox x:Name="Origin" Margin="0,0,0,11" AutomationProperties.Name="HTTPS-адрес Notify"/>
          <TextBlock x:Name="TokenLabel" Text="Токен источника" Margin="0,0,0,5"/>
          <PasswordBox x:Name="Token" Margin="0,0,0,11" AutomationProperties.Name="Токен источника"/>
          <TextBlock Text="Клиент" Margin="0,0,0,5"/>
          <ComboBox x:Name="Client" SelectedIndex="0" SelectionChanged="ClientChanged"
                    AutomationProperties.Name="Клиент" Padding="8,5" Margin="0,0,0,11">
            <ComboBoxItem Content="Codex"/>
            <ComboBoxItem Content="Harness"/>
          </ComboBox>
          <StackPanel x:Name="CodexPicker">
            <TextBlock Text="Существующий чат Codex" Margin="0,0,0,5"/>
            <DockPanel Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Content="Обновить список" Click="RefreshChats" Margin="8,0,0,0"/>
              <ComboBox x:Name="Chats" Padding="8,5" MaxDropDownHeight="320" ItemTemplate="{StaticResource ChatLabel}"
                        AutomationProperties.Name="Существующий чат Codex"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Content="Найти доступный чат" Click="FindAvailableChat" Margin="8,0,0,0"/>
              <TextBlock x:Name="ChatStatus" Text="Выберите чат из списка." VerticalAlignment="Center"
                         Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
          </StackPanel>
          <WrapPanel>
            <Button Content="Подключить" Click="Connect" Style="{StaticResource AccentButton}" FontWeight="SemiBold"/>
            <Button Content="Проверить соединение" Click="Check"/>
            <Button Content="Кабинет Notify" Click="OpenCabinet"/>
          </WrapPanel>
        </StackPanel>

          </Border>
        </StackPanel>
        <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed">
          <TextBlock Text="Диагностика" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Регистрация агента и последние события подключения." Style="{StaticResource Description}" Margin="0,0,0,20"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Регистрация" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <TextBlock Text="Agent ID"/>
              <DockPanel Margin="0,4,0,10">
                <Button DockPanel.Dock="Right" Content="Копировать" Click="CopyId" Tag="Agent" AutomationProperties.Name="Копировать Agent ID" Margin="8,0,0,0"/>
                <TextBox x:Name="AgentId" IsReadOnly="True" AutomationProperties.Name="Agent ID"/>
              </DockPanel>
              <TextBlock Text="Source ID"/>
              <DockPanel Margin="0,4,0,12">
                <Button DockPanel.Dock="Right" Content="Копировать" Click="CopyId" Tag="Source" AutomationProperties.Name="Копировать Source ID" Margin="8,0,0,0"/>
                <TextBox x:Name="SourceId" IsReadOnly="True" AutomationProperties.Name="Source ID"/>
              </DockPanel>
              <Button Content="Проверить соединение" Click="Check" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Последние события" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock x:Name="History" Text="Событий пока нет." Style="{StaticResource Description}" LineHeight="23"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
          <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
          <Border Style="{StaticResource Card}" Margin="0,16,0,12">
            <StackPanel>
              <TextBlock Text="Оформление" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <ComboBox x:Name="Appearance" HorizontalAlignment="Left" MinWidth="175"
                        AutomationProperties.Name="Тема оформления" SelectionChanged="ChangeAppearance">
                <ComboBoxItem Content="Как в Windows" Tag="System"/>
                <ComboBoxItem Content="Светлая" Tag="Light"/>
                <ComboBoxItem Content="Тёмная" Tag="Dark"/>
              </ComboBox>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Фоновая работа" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <CheckBox x:Name="AutoStart" Content="Запускать в трее при входе в Windows" Margin="0,0,0,9" Click="ChangeStartup"/>
              <CheckBox x:Name="KeepInTray" Content="Оставлять приложение в трее при закрытии окна" Click="ChangeBackground"/>
              <TextBlock Text="В трее агент остаётся на связи. Для полного завершения используйте «Выход»." Style="{StaticResource Description}" Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Padding="28,10">
      <TextBlock x:Name="Status" Text="Отключено" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"
                 AutomationProperties.LiveSetting="Polite"/>
    </Border>
  </Grid>
</Window>
